# Основная переменная безопасности
SESSION_SECRET=

# Почта для обязательных уведомлений менеджерам
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
BOOKING_EMAIL_TO=
BOOKING_EMAIL_ENABLED=true

# Укажите обе переменные только для SMTP с авторизацией
SMTP_USER=
SMTP_PASS=

# Telegram — дополнительный канал уведомлений
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_IP=

# PostgreSQL для обязательного сохранения заявок
DATABASE_URL=
