#!/usr/bin/env bash
set -Eeuo pipefail

umask 027

readonly BASE_DIR="/var/www/almare"
readonly RELEASES_DIR="${BASE_DIR}/releases"
readonly CURRENT_LINK="${BASE_DIR}/current"
readonly INCOMING_DIR="/home/almare-deploy/incoming"
readonly APP_SERVICE="almare.service"
readonly APP_USER="almare"
readonly APP_GROUP="almare"

commit_sha="${1:-}"
if [[ ! "${commit_sha}" =~ ^[0-9a-f]{40}$ ]]; then
  echo "A full 40-character lowercase Git commit SHA is required." >&2
  exit 2
fi

archive="${INCOMING_DIR}/${commit_sha}.tgz"
release="${RELEASES_DIR}/${commit_sha}"
stage="${RELEASES_DIR}/.staging-${commit_sha}"

if [[ ! -f "${archive}" ]]; then
  echo "Release archive not found: ${archive}" >&2
  exit 2
fi

install -d -o root -g root -m 0755 "${RELEASES_DIR}"

exec 9>"/run/lock/almare-deploy.lock"
if ! flock -n 9; then
  echo "Another AL MARE deployment is already running." >&2
  exit 3
fi

safe_remove_release_dir() {
  local target="$1"
  local resolved
  resolved="$(realpath -m -- "${target}")"

  if [[ "${resolved}" != "${RELEASES_DIR}/"* ]]; then
    echo "Refusing to remove path outside release directory: ${resolved}" >&2
    return 1
  fi

  local base_name
  base_name="$(basename -- "${resolved}")"
  if [[ ! "${base_name}" =~ ^(\.staging-)?[0-9a-f]{40}$ ]]; then
    echo "Refusing to remove unexpected release path: ${resolved}" >&2
    return 1
  fi

  rm -rf -- "${resolved}"
}

cleanup_stage() {
  if [[ -e "${stage}" ]]; then
    safe_remove_release_dir "${stage}" || true
  fi
}
trap cleanup_stage ERR INT TERM

existing_current="$(readlink -f -- "${CURRENT_LINK}" 2>/dev/null || true)"
if [[ "${existing_current}" == "${release}" && -f "${release}/dist/startup.cjs" ]]; then
  if systemctl is-active --quiet "${APP_SERVICE}" && \
    curl --fail --silent --show-error \
      --header "Host: hotel-almare.ru" \
      "http://127.0.0.1:3000/probe" >/dev/null && \
    curl --fail --silent --show-error \
      "https://hotel-almare.ru/probe" >/dev/null; then
    rm -f -- "${archive}"
    echo "AL MARE release is already active and healthy: ${commit_sha}"
    exit 0
  fi

  echo "The requested release is already current but unhealthy; manual recovery is required." >&2
  exit 5
fi

if [[ -e "${stage}" ]]; then
  safe_remove_release_dir "${stage}"
fi

mapfile -t archive_entries < <(tar -tzf "${archive}")
if (( ${#archive_entries[@]} == 0 )); then
  echo "Release archive is empty." >&2
  exit 4
fi

for entry in "${archive_entries[@]}"; do
  if [[ "${entry}" == /* || "${entry}" == ".." || "${entry}" == ../* || "${entry}" == *"/../"* || "${entry}" == *"/.." ]]; then
    echo "Unsafe archive path: ${entry}" >&2
    exit 4
  fi

  case "${entry}" in
    dist|dist/|dist/*|package.json|package-lock.json|scripts|scripts/|scripts/booking-form-monitor.mjs)
      ;;
    *)
      echo "Unexpected file in release archive: ${entry}" >&2
      exit 4
      ;;
  esac
done

if tar -tvzf "${archive}" | grep -Eq '^[lh]'; then
  echo "Release archive must not contain symbolic or hard links." >&2
  exit 4
fi

install -d -o "${APP_USER}" -g "${APP_GROUP}" -m 0750 "${stage}"
tar --extract --gzip --file "${archive}" --directory "${stage}" \
  --no-same-owner --no-same-permissions
chown -R "${APP_USER}:${APP_GROUP}" "${stage}"

for required_path in \
  "${stage}/dist/startup.cjs" \
  "${stage}/dist/app.cjs" \
  "${stage}/dist/public/index.html" \
  "${stage}/package.json" \
  "${stage}/package-lock.json" \
  "${stage}/scripts/booking-form-monitor.mjs"; do
  if [[ ! -f "${required_path}" ]]; then
    echo "Required release file is missing: ${required_path}" >&2
    exit 4
  fi
done

(
  cd "${stage}"
  runuser -u "${APP_USER}" -- env \
    HOME="/var/lib/almare" \
    npm_config_cache="/var/lib/almare/.npm" \
    NODE_OPTIONS="--max-old-space-size=384" \
    npm ci --omit=dev --no-audit --no-fund
)

chown -R root:"${APP_GROUP}" "${stage}"
chmod -R u=rwX,g=rX,o= "${stage}"

for env_file in .env.secrets .env.production; do
  if [[ -f "${BASE_DIR}/${env_file}" ]]; then
    ln -s "${BASE_DIR}/${env_file}" "${stage}/${env_file}"
  fi
done

if [[ -e "${release}" ]]; then
  safe_remove_release_dir "${release}"
fi
mv -- "${stage}" "${release}"
trap - ERR INT TERM

previous_release="$(readlink -f -- "${CURRENT_LINK}" 2>/dev/null || true)"
new_link="${BASE_DIR}/.current-${commit_sha}"
rm -f -- "${new_link}"
ln -s "releases/${commit_sha}" "${new_link}"
mv -Tf -- "${new_link}" "${CURRENT_LINK}"

if ! systemctl restart "${APP_SERVICE}"; then
  if [[ -n "${previous_release}" && -d "${previous_release}" ]]; then
    rollback_link="${BASE_DIR}/.current-rollback"
    rm -f -- "${rollback_link}"
    ln -s "${previous_release}" "${rollback_link}"
    mv -Tf -- "${rollback_link}" "${CURRENT_LINK}"
    systemctl restart "${APP_SERVICE}" || true
  fi
  exit 5
fi

healthy=false
for _ in {1..30}; do
  if curl --fail --silent --show-error \
    --header "Host: hotel-almare.ru" \
    "http://127.0.0.1:3000/probe" >/dev/null && \
    curl --fail --silent --show-error \
      "https://hotel-almare.ru/probe" >/dev/null; then
    healthy=true
    break
  fi
  sleep 1
done

if [[ "${healthy}" != "true" ]]; then
  echo "New release failed its local health check; rolling back." >&2
  if [[ -n "${previous_release}" && -d "${previous_release}" ]]; then
    rollback_link="${BASE_DIR}/.current-rollback"
    rm -f -- "${rollback_link}"
    ln -s "${previous_release}" "${rollback_link}"
    mv -Tf -- "${rollback_link}" "${CURRENT_LINK}"
    systemctl restart "${APP_SERVICE}" || true
  fi
  exit 5
fi

rm -f -- "${archive}"

current_release="$(readlink -f -- "${CURRENT_LINK}")"
mapfile -t release_dirs < <(
  find "${RELEASES_DIR}" -mindepth 1 -maxdepth 1 -type d \
    -regextype posix-extended -regex '.*/[0-9a-f]{40}' \
    -printf '%T@ %p\n' | sort -nr | cut -d' ' -f2-
)

kept_noncurrent=0
for old_release in "${release_dirs[@]}"; do
  if [[ "$(realpath -m -- "${old_release}")" == "${current_release}" ]]; then
    continue
  fi

  if (( kept_noncurrent < 2 )); then
    ((kept_noncurrent += 1))
    continue
  fi

  safe_remove_release_dir "${old_release}"
done

echo "AL MARE deployment succeeded: ${commit_sha}"
