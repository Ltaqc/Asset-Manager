SMTP_PORT=465
SMTP_HELO_NAME=hotelalmare.ru
SMTP_FROM=almare@hotelalmare.ru
BOOKING_EMAIL_TO=almare@hotelalmare.ru,Troyan.nastasya@mail.ru
BOOKING_EMAIL_ENABLED=false

# The DNS-selected Telegram IP is unreachable from this VPS network.
TELEGRAM_API_IP=149.154.167.220
